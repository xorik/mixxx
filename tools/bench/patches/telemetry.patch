+// --- WAVEFORM PERFORMANCE TELEMETRY -----------------------------------------
+// One line per second, only with --developer, so a build measured by the
+// benchmark harness can be compared with any other. Two rules behind the field
+// list:
+//   * report what REALLY happened, never what was requested: type= and
+//     options= are the values the widgets were actually built with, because
+//     Mixxx can silently substitute both (an unknown WaveformType is replaced
+//     by RGB on profiles older than 2.6);
+//   * report the rasterised area, because frame cost is meaningless without it.
+//
+// BENCHFLAG / BENCHHIT convention, used by every experimental patch layered on
+// top of this one: at startup each MIXXX_BENCH_* switch is logged as BENCHFLAG
+// (what was asked for), and the code path it enables logs BENCHHIT when it
+// really executes (what happened). A measurement of a change that never ran is
+// then impossible to mistake for a measurement of the change.
+double g_perfRenderMs = 0.0;     // waveform render() calls, summed over a second
+double g_perfSwapMs = 0.0;       // swapBuffers() calls, summed over a second
+int g_perfEffectiveOptions = -1; // waveform_options the widgets were BUILT with
+
+void logBenchFlags() {
+    const QProcessEnvironment env = QProcessEnvironment::systemEnvironment();
+    const QStringList keys = env.keys();
+    for (const QString& key : keys) {
+        if (key.startsWith(QLatin1String("MIXXX_BENCH_"))) {
+            qDebug().nospace() << "BENCHFLAG " << key << "=" << env.value(key);
+        }
+    }
+}
